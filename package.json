{
    "name": "flexy-deps",
    "description": "A flexible dependency management tool inspired by Symfony Flex, allowing you to easily add dependencies based on predefined recipes.",
    "version": "0.0.0",
    "author": "Adam Gąsowski",
    "license": "MIT",
    "type": "module",
    "main": "./dist/cli.cjs",
    "bin": {
        "flexy-deps": "dist/cli.cjs"
    },
    "exports": {
        ".": "./dist/cli.cjs",
        "./package.json": "./package.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gander-tools/flexy-deps.git"
    },
    "bugs": {
        "url": "https://github.com/gander-tools/flexy-deps/issues"
    },
    "homepage": "https://github.com/gander-tools/flexy-deps",
    "files": [
        "dist/",
        "README.md",
        "LICENSE"
    ],
    "keywords": [
        "npm",
        "dependencies",
        "flex",
        "automation",
        "package-manager",
        "dependency-management",
        "npm-scripts"
    ],
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@inquirer/prompts": "^8.0.0",
        "commander": "^14.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.1.2",
        "@commander-js/extra-typings": "^14.0.0",
        "@types/node": "^24.0.15",
        "git-cliff": "^2.9.1",
        "lefthook": "^2.0.0",
        "release-it": "^19.0.4",
        "tsdown": "^0.23.0"
    },
    "peerDependencies": {
        "typescript": "^5.8.3"
    },
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "check": "biome check",
        "check:fix": "biome check --write",
        "format": "biome format",
        "format:fix": "biome format --write",
        "lint": "biome lint",
        "lint:fix": "biome lint --write",
        "build": "tsdown",
        "build:watch": "tsdown --watch",
        "build:exports": "tsdown --exports",
        "release": "release-it"
    }
}
